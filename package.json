{
  "name": "evg-music-player",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "A skinned music player written in Ranger and drawn by EVG's WebGL painter",
  "type": "module",
  "scripts": {
    "deps": "rgrc install",
    "build": "node scripts/build.mjs",
    "web": "node scripts/build.mjs && node web/serve.mjs",
    "native": "node scripts/build-native.mjs",
    "native:run": "node scripts/build-native.mjs --run",
    "native:check": "node scripts/check-native.mjs",
    "native:icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "ranger-compiler": "4.0.1"
  }
}
